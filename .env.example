# Copy this file to .env and fill in ONE key. NEVER commit .env.
#
# Model names are NOT configured here on purpose: the lab requires them to be
# declared in source code. See src/config.py (PROVIDERS / resolve_provider).
#
# The runner picks whichever provider has a key, preferring Groq.

# Groq - free tier, thousands of requests/day, no card required.
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenRouter - alternative. Free models are capped at ~50 requests/day until
# the account purchases credits; this lab needs ~250.
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides
# LLM_PROVIDER=groq                              # force one provider
# LLM_API_BASE=http://localhost:11434/v1         # or any OpenAI-compatible server
